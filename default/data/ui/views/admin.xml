<dashboard version="1.1" script="registration_admin.js" stylesheet="registration.css" hideEdit="true" theme="dark">
  <label>CTF Registration Admin</label>
  <row>
    <panel>
      <html>
        <div id="ctfr-admin-root" class="ctfr-shell">
          <div class="ctfr-hero">
            <div>
              <h1>CTF Event Administration</h1>
              <p>Create and manage multiple concurrent CTF registration windows.</p>
            </div>
            <button id="ctfr-new-event" type="button" class="btn btn-primary">New CTF</button>
          </div>

          <div id="ctfr-admin-message" class="ctfr-message" style="display:none;"></div>

          <div class="ctfr-admin-grid">
            <section class="ctfr-card">
              <div class="ctfr-card-heading"><h2>CTF Events</h2></div>
              <div class="ctfr-table-wrap">
                <table class="table table-striped" id="ctfr-events-table">
                  <thead>
                    <tr><th>Name</th><th>Registration</th><th>Event</th><th>Starts</th><th></th></tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
            </section>

            <section class="ctfr-card">
              <h2 id="ctfr-editor-title">Create CTF</h2>
              <form id="ctfr-admin-form" class="ctfr-admin-form">
                <label for="ctfr-ctf-id">CTF ID</label>
                <input id="ctfr-ctf-id" type="text" maxlength="64" placeholder="asteron-easy-2026" required="required" />

                <label for="ctfr-name">Name</label>
                <input id="ctfr-name" type="text" maxlength="120" required="required" />

                <label for="ctfr-short-description">Short description</label>
                <textarea id="ctfr-short-description" maxlength="280" required="required"></textarea>

                <label for="ctfr-description">Full description</label>
                <textarea id="ctfr-description" maxlength="6000" required="required"></textarea>

                <div class="ctfr-image-admin">
                  <label for="ctfr-image-file">Event image</label>
                  <div class="ctfr-image-admin-grid">
                    <div class="ctfr-image-preview-wrap">
                      <img id="ctfr-image-preview" class="ctfr-image-preview"
                           src="/static/app/SA-ctf_registration/images/default-ctf.svg"
                           alt="CTF image preview"/>
                    </div>
                    <div class="ctfr-image-controls">
                      <input id="ctfr-image-file" type="file"
                             accept="image/png,image/jpeg,image/webp"/>
                      <p class="ctfr-help">PNG, JPEG, or WebP. Maximum 5 MB.</p>
                      <button id="ctfr-use-default-image" type="button" class="btn">Use Default Image</button>
                      <div id="ctfr-upload-status" class="ctfr-upload-status"></div>
                    </div>
                  </div>
                  <details class="ctfr-image-advanced">
                    <summary>Advanced: image URL/path</summary>
                    <label for="ctfr-image-url">Image URL/path</label>
                    <input id="ctfr-image-url" type="text" maxlength="1000"
                           value="/static/app/SA-ctf_registration/images/default-ctf.svg"
                           placeholder="/static/app/SA-ctf_registration/images/uploads/asteron-easy-2026.png"/>
                  </details>
                </div>

                <label for="ctfr-registration-opens">Registration opens</label>
                <input id="ctfr-registration-opens" type="datetime-local" required="required" />

                <label for="ctfr-registration-closes">Registration closes</label>
                <input id="ctfr-registration-closes" type="datetime-local" required="required" />

                <label for="ctfr-event-starts">Event starts</label>
                <input id="ctfr-event-starts" type="datetime-local" required="required" />

                <label for="ctfr-event-ends">Event ends</label>
                <input id="ctfr-event-ends" type="datetime-local" required="required" />

                <label for="ctfr-search-url">Search URL</label>
                <input id="ctfr-search-url" type="url" maxlength="1000" required="required" />

                <label for="ctfr-search-desc">Search URL description</label>
                <input id="ctfr-search-desc" type="text" maxlength="120" />

                <label for="ctfr-scoring-url">Scoring URL</label>
                <input id="ctfr-scoring-url" type="url" maxlength="1000" />

                <label for="ctfr-participant-roles">Participant roles</label>
                <input id="ctfr-participant-roles" type="text" maxlength="250" value="ctf_competitor" required="required" />
                <p class="ctfr-help">Roles must also be listed in allowed_participant_roles in ctf_registration.conf.</p>

                <label class="ctfr-check"><input id="ctfr-enabled" type="checkbox" checked="checked" /> Enabled</label>
                <label class="ctfr-check"><input id="ctfr-allow-updates" type="checkbox" checked="checked" /> Allow registration updates while open</label>

                <section class="ctfr-content-import">
                  <h3>Questions, Answers, and Hints</h3>
                  <p class="ctfr-help">Optional when creating or editing a CTF. Upload any one or more files to replace only those content types; files you do not select are left unchanged. Cross-file relationships are validated against the retained content. Files generated by SILK SPECTER <code>make package</code> are accepted directly.</p>

                  <label for="ctfr-questions-csv">Questions CSV</label>
                  <input id="ctfr-questions-csv" type="file" accept=".csv,text/csv" />

                  <label for="ctfr-answers-csv">Answers CSV</label>
                  <input id="ctfr-answers-csv" type="file" accept=".csv,text/csv" />

                  <label for="ctfr-hints-csv">Hints CSV</label>
                  <input id="ctfr-hints-csv" type="file" accept=".csv,text/csv" />

                  <label class="ctfr-check"><input id="ctfr-use-event-window" type="checkbox" checked="checked" /> Use the CTF event start/end as the scoring window for every imported question</label>
                  <p class="ctfr-help">Clear this only when the questions CSV intentionally contains per-question StartTime and EndTime values.</p>
                </section>

                <br/>
                <button id="ctfr-save-event" type="submit" class="btn btn-primary">Save CTF</button>
              </form>
            </section>
          </div>

          <section id="ctfr-roster-panel" class="ctfr-card ctfr-roster-panel" style="display:none;">
            <div class="ctfr-card-heading">
              <h2>Selected CTF Roster</h2>
              <button id="ctfr-refresh-roster" type="button" class="btn">Refresh</button>
            </div>
            <div id="ctfr-roster-summary">Loading…</div>
            <div class="ctfr-table-wrap">
              <table class="table table-striped" id="ctfr-roster-table">
                <thead><tr><th>Username</th><th>Display</th><th>Team</th><th>Email</th></tr></thead>
                <tbody></tbody>
              </table>
            </div>
          </section>
        </div>
      </html>
    </panel>
  </row>
</dashboard>
